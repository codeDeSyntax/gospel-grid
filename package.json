{
  "name": "wingrid",
  "productName": "Wingrid",
  "version": "2.2.31",
  "main": "dist-electron/main/index.js",
  "description": "wingrid. A tool for aggregating different windows into one",
  "author": "https://josiokssolutions.com",
  "license": "MIT",
  "private": true,
  "overrides": {
    "builder-util-runtime": "9.3.1"
  },
  "debugEnv": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:audio": "node server/audio-transcription/index.js",
    "check:remote-screen": "tsc --noEmit",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "package": "electron-packager . wingrid --platform=win32 --arch=x64  --icon=J:\\electron\\wingrid\\public\\wingrid.ico --out=release/ --overwrite --asar",
    "dist:win": "electron-builder --win",
    "verify:package": "node ./scripts/verify-builder-package.mjs",
    "release": "node ./scripts/release.mjs",
    "release:publish": "electron-builder --win --publish=always"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "@xenova/transformers": "^2.17.2",
    "argparse": "^2.0.1",
    "builder-util-runtime": "9.3.1",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^17.2.2",
    "electron-packager": "^17.1.2",
    "electron-updater": "6.3.9",
    "express": "^4.18.2",
    "framer-motion": "^12.23.15",
    "fs-extra": "^11.3.5",
    "geist": "^1.7.0",
    "graceful-fs": "^4.2.11",
    "js-yaml": "^4.1.1",
    "jsonfile": "^6.2.1",
    "lazy-val": "^1.0.5",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^0.544.0",
    "ms": "2.1.3",
    "multer": "^1.4.5-lts.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "sax": "1.4.1",
    "semver": "7.7.4",
    "tailwind-merge": "^3.5.0",
    "tiny-typed-emitter": "^2.1.0",
    "universalify": "^2.0.1",
    "wav": "^1.0.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^24.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-redux": "^7.1.34",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
